# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Alpaca paper trading (leave blank for local simulation) ─────────
BROKER=paper                          # "paper" | "alpaca"
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Universe ──────────────────────────────────────────────────────────────────
# Comma-separated tickers to include in the screening universe
# UNIVERSE=AAPL,MSFT,GOOGL,...

# ── Screening ─────────────────────────────────────────────────────────────────
MIN_MARKET_CAP_B=5
MIN_AVG_VOLUME=500000
MAX_STOCKS_AFTER_SCREEN=20

# ── Portfolio ─────────────────────────────────────────────────────────────────
MAX_POSITIONS=10
MAX_POSITION_PCT=0.15
PORTFOLIO_CASH_RESERVE=0.05

# ── Backtest ──────────────────────────────────────────────────────────────────
BACKTEST_YEARS=3
BACKTEST_INITIAL_CAPITAL=100000

# ── Scheduler ─────────────────────────────────────────────────────────────────
DAILY_RUN_TIME=09:30
TIMEZONE=US/Eastern

# ── Claude model override ─────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
